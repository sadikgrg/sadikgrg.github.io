---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Projects
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.projects.map((project, index) => {
                return (
                  <article class="group relative">
                    <div
                      class="relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
                    >
                      <div class="space-y-4">
                        {project.video && (
                          <div class="overflow-hidden rounded-lg sm:rounded-xl border border-gray-200 bg-gray-950 shadow-sm">
                            <video
                              class="aspect-video w-full bg-gray-950 object-contain"
                              controls
                              playsinline
                              preload="metadata"
                              poster={project.video.poster}
                              aria-label={project.video.title}
                            >
                              <source src={project.video.src} type="video/mp4" />
                              Your browser does not support embedded videos.
                            </video>
                          </div>
                        )}

                        {project.screenshots && project.screenshots.length > 0 && (
                          <div
                            class={`grid grid-cols-1 gap-4 ${project.screenshots.length > 1 ? "sm:grid-cols-2" : ""}`}
                          >
                            {project.screenshots.map((screenshot) => (
                              <figure class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm sm:rounded-xl">
                                <a
                                  href={screenshot.src.src}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="block overflow-hidden"
                                  aria-label={`Open ${screenshot.caption} image`}
                                >
                                  <img
                                    src={screenshot.src.src}
                                    width={screenshot.src.width}
                                    height={screenshot.src.height}
                                    alt={screenshot.alt}
                                    loading="lazy"
                                    decoding="async"
                                    class="aspect-video h-auto w-full object-cover transition-transform duration-300 hover:scale-[1.02]"
                                  />
                                </a>
                                <figcaption class="px-3 py-2 text-sm text-gray-600">
                                  {screenshot.caption}
                                </figcaption>
                              </figure>
                            ))}
                          </div>
                        )}

                        <div class="flex items-start justify-between gap-4">
                          <div>
                            <span
                              class="text-sm font-mono"
                              style={{ color: siteConfig.accentColor }}
                            >
                              0{index + 1}
                            </span>
                            <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">
                              {project.name}
                            </h3>
                          </div>

                          {project.link && (
                            <a
                              href={project.link}
                              target="_blank"
                              rel="noopener noreferrer"
                              aria-label={`View ${project.name} project`}
                              class="flex-shrink-0 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 hover:bg-gray-700 hover:-translate-y-0.5"
                            >
                              <svg
                                class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M7 17L17 7M17 7H7M17 7V17"
                                />
                              </svg>
                            </a>
                          )}
                        </div>

                        <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
                          {project.description}
                        </p>

                        {project.report && (
                          <a
                            href={project.report.src}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-3.5 py-2 text-sm font-semibold text-gray-800 transition-colors hover:border-gray-400 hover:bg-gray-100"
                          >
                            <svg
                              aria-hidden="true"
                              class="h-4 w-4"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M7 3h7l5 5v13H7V3Zm7 0v5h5M10 13h6M10 17h6"
                              />
                            </svg>
                            {project.report.label}
                          </a>
                        )}

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                            {project.skills.map((skill) => (
                              <span
                                class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 group-hover:bg-gray-800"
                              >
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
